# WordPress REST API root. Defaults to the production backend when unset.
# Point this at the mock server for offline work:
#   npm run mock:wp
#   WORDPRESS_API_URL=http://127.0.0.1:8081/wp-json/wp/v2 npm run dev
WORDPRESS_API_URL=http://wp.consciousnessnetworks.com/wp-json/wp/v2

# Origin that serves /wp-content/uploads. Proxied over HTTPS by next.config.js.
WORDPRESS_UPLOADS_ORIGIN=http://wp.consciousnessnetworks.com

# Contact form delivery (Resend). Without a key the form returns 503 and the
# page shows the fallback email address.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM=Consciousness Networks <onboarding@resend.dev>

# Machine translation of WordPress article bodies into Spanish. Interface copy
# is translated in lib/dictionaries.ts and does not need this. When the key is
# absent, Spanish pages fall back to the English body.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
